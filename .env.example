# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sanity CMS Configuration
REACT_APP_SANITY_PROJECT_ID=7yjhdw88
REACT_APP_SANITY_DATASET=production

# Sanity Write Token (Required only for scripts/sanity/publish-article.mjs)
SANITY_WRITE_TOKEN=your-sanity-write-token

# Coaches: Sanity is the source of truth, Supabase is the backup.
# Secret of the Sanity webhook (manage.sanity.io -> API -> Webhooks) pointing to /api/webhooks/sanity-coach
SANITY_WEBHOOK_SECRET=choose-a-long-random-string
# Server-only. Supabase dashboard -> Settings -> API -> service_role. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
